{%- liquid
  assign image = block.settings.image
  if image == blank and block.settings.collection != blank
    assign image = block.settings.collection.featured_image
  endif
  if image == blank
    for candidate in collections.all.products offset: 2 limit: 10
      if candidate.featured_media
        assign image = candidate.featured_media.preview_image
        break
      endif
    endfor
  endif
-%}
<figure class="st-block st-block-image" style="--ratio: {{ block.settings.ratio }}; --w: {{ block.settings.width }}%;" {{ block.shopify_attributes }}>
  {%- if image != blank -%}
    {% render 'image', image: image, sizes: '(min-width: 990px) 50vw, 100vw' %}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'st-placeholder' }}
  {%- endif -%}
  {%- if block.settings.caption != blank -%}
    <figcaption class="st-small st-muted">{{ block.settings.caption | escape }}</figcaption>
  {%- endif -%}
</figure>

{% schema %}
{
  "name": "t:names.image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "collection", "id": "collection", "label": "t:labels.image_collection", "info": "t:info.image_collection" },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "auto", "label": "t:options.original" },
        { "value": "3 / 4", "label": "t:options.portrait" },
        { "value": "1", "label": "t:options.square" },
        { "value": "4 / 3", "label": "t:options.landscape" }
      ],
      "default": "3 / 4"
    },
    { "type": "range", "id": "width", "label": "t:labels.width", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "caption", "label": "t:labels.caption" }
  ],
  "presets": [{ "name": "t:names.image" }]
}
{% endschema %}
