{%- assign form_id = 'CartForm-drawer' -%}
{%- comment -%}
  The cart as a room card: a wide sheet that rises from the bottom edge. The pieces stand side by side as arched
  cards in one row that scrolls sideways, and a walnut summary block holds the delivery meter, subtotal and checkout.
  On phones it is a full screen sheet: the pieces as a vertical list, the subtotal and checkout in a bar at the bottom.
{%- endcomment -%}
<dialog class="sh-roomcart color-{{ settings.drawer_scheme }}" id="CartDrawer" aria-labelledby="CartDrawerTitle">
  <st-cart class="sh-roomcart__cart" data-section-id="cart-drawer">
    <div class="sh-roomcart__head">
      <h2 class="sh-roomcart__title" id="CartDrawerTitle">
        <span aria-hidden="true">{{ 'cart.title' | t }}</span>
        <span class="st-visually-hidden" data-st-cart-label>{{ 'cart.title_with_count' | t: count: cart.item_count }}</span>
      </h2>
      <span class="sh-roomcart__count" data-st-cart-count aria-hidden="true"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      <button type="button" class="sh-roomcart__close" data-st-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="sh-roomcart__content" data-st-cart-content data-count="{{ cart.item_count }}" data-count-label="{{ 'cart.title_with_count' | t: count: cart.item_count }}">
      {%- if cart.item_count > 0 -%}
        <div class="sh-roomcart__body">
          <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="sh-roomcart__lines" novalidate>
            <st-slider class="sh-roomcart__slider">
              <div class="sh-roomcart__track" data-st-slider-track tabindex="0" role="region" aria-label="{{ 'sh_layout.cart_pieces' | t }}">
                {% render 'cart-lines', section_id: 'drawer', layout: 'row' %}
              </div>
              {%- assign pieces_label = 'sh_layout.cart_pieces' | t -%}
              {% render 'slider-controls', label: pieces_label %}
            </st-slider>
          </form>
          <div class="sh-roomcart__summary">
            {% render 'cart-summary', form_id: form_id, show_note: false %}
            <a class="sh-roomcart__view" href="{{ routes.cart_url }}">{{ 'cart.view' | t }}</a>
          </div>
        </div>
      {%- else -%}
        <div class="sh-roomcart__empty">
          <p class="sh-roomcart__empty-title">{{ 'cart.empty' | t }}</p>
          {%- if section.settings.show_rooms -%}
            <div class="sh-roomcart__empty-rooms">
              <p class="st-field__label">{{ 'cart.empty_rooms' | t }}</p>
              {%- assign rooms_label = 'cart.empty_rooms' | t -%}
              {% render 'room-chips', menu: section.settings.rooms_menu, label: rooms_label, limit: 6 %}
            </div>
          {%- endif -%}
          <a class="st-button st-button--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </st-cart>
</dialog>

{% schema %}
{
  "name": "t:names.cart_drawer",
  "settings": [
    { "type": "checkbox", "id": "show_rooms", "label": "t:labels.show_empty_rooms", "default": true },
    { "type": "link_list", "id": "rooms_menu", "label": "t:labels.rooms_menu", "info": "t:info.rooms_menu" }
  ]
}
{% endschema %}
