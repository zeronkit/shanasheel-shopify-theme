{%- comment -%} Shanasheel theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- comment -%}
  Shanasheel footer: a row of three arched "window" panels (about, newsletter, contact),
  then a walnut band with menu columns, social, localization, payments and legal.
  Menu blocks fall back to the "footer" menu, then to common pages, so the band is never empty.
{%- endcomment -%}
{%- liquid
  assign auto_pages = 'about-us,contact,faq,size-guide,shipping-and-returns,returns,shipping' | split: ','
  assign newsletter_block = section.blocks | where: 'type', 'newsletter' | first
-%}
<footer class="sh-ft sh-ft--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}">
  <div class="sh-ft__windows st-wrap">
    {%- if section.settings.show_brand -%}
      <div class="sh-ft__window">
        <p class="sh-ft__wordmark">{{ shop.name | escape }}</p>
        {%- if section.settings.brand_text != blank -%}<div class="st-rte">{{ section.settings.brand_text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if newsletter_block -%}
      <div class="sh-ft__window sh-ft__window--newsletter" {{ newsletter_block.shopify_attributes }}>
        {%- if newsletter_block.settings.heading != blank -%}
          <h2 class="sh-ft__heading">{{ newsletter_block.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if newsletter_block.settings.text != blank -%}
          <div class="st-rte">{{ newsletter_block.settings.text }}</div>
        {%- endif -%}
        {% render 'newsletter-form', id: 'FooterNewsletter' %}
      </div>
    {%- endif -%}

    {%- assign footer_email = settings.contact_email | strip -%}
    {%- if section.settings.contact_heading != blank or section.settings.contact_text != blank or footer_email != blank -%}
      <div class="sh-ft__window">
        {%- if section.settings.contact_heading != blank -%}
          <h2 class="sh-ft__heading">{{ section.settings.contact_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.contact_text != blank -%}<div class="st-rte">{{ section.settings.contact_text }}</div>{%- endif -%}
        {%- if footer_email != blank -%}
          <p class="sh-ft__mail">
            <span class="sh-ft__mail-label">{{ 'general.footer_write_to_us' | t }}</span>
            <a href="mailto:{{ footer_email | escape }}">{{ footer_email | escape }}</a>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="sh-ft__band">
    <svg class="sh-ft__lattice" aria-hidden="true" focusable="false" preserveAspectRatio="none" viewBox="0 0 120 12">
      <defs>
        <pattern id="ShFtLattice" width="12" height="12" patternUnits="userSpaceOnUse">
          <path d="M0 6 L6 0 L12 6 L6 12 Z" fill="none" stroke="#C9A36A" stroke-width="1.2"/>
          <circle cx="6" cy="6" r="1.4" fill="#D8BC86"/>
        </pattern>
      </defs>
      <rect width="120" height="12" fill="url(#ShFtLattice)"/>
    </svg>

    <div class="st-wrap">
      {%- assign has_columns = false -%}
      {%- for block in section.blocks -%}{%- unless block.type == 'newsletter' -%}{%- assign has_columns = true -%}{%- endunless -%}{%- endfor -%}
      {%- if has_columns -%}
        <div class="sh-ft__cols">
          {%- for block in section.blocks -%}
            {%- if block.type == 'newsletter' -%}{%- continue -%}{%- endif -%}
            <div class="sh-ft__col sh-ft__col--{{ block.type }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'menu' -%}
                  {%- liquid
                    assign footer_menu = block.settings.menu
                    if footer_menu.links.size == 0
                      assign footer_menu = linklists['footer']
                    endif
                    assign heading = block.settings.heading
                    if heading == blank and footer_menu.links.size > 0
                      assign heading = footer_menu.title
                    endif
                  -%}
                  {%- if heading != blank -%}
                    <h2 class="sh-ft__heading">{{ heading | escape }}</h2>
                  {%- endif -%}
                  <ul class="sh-ft__links" role="list">
                    {%- if footer_menu.links.size > 0 -%}
                      {%- for link in footer_menu.links -%}
                        <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for handle in auto_pages -%}
                        {%- if pages[handle].title != blank -%}
                          <li><a href="{{ pages[handle].url }}">{{ pages[handle].title | escape }}</a></li>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if blogs.news.articles_count > 0 -%}
                        <li><a href="{{ blogs.news.url }}">{{ blogs.news.title | escape }}</a></li>
                      {%- endif -%}
                      <li><a href="{{ routes.search_url }}">{{ 'search.title' | t }}</a></li>
                    {%- endif -%}
                  </ul>
                {%- when 'text' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="sh-ft__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <div class="st-rte">{{ block.settings.text }}</div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="sh-ft__row">
        {%- if section.settings.show_social -%}
          {% render 'social-icons' %}
        {%- endif -%}
        {%- if section.settings.show_follow_on_shop and shop.features.follow_on_shop? -%}
          <div class="sh-ft__follow">{{ shop | login_button: action: 'follow' }}</div>
        {%- endif -%}
        {% render 'localization', id: 'FooterLocalization', show_country: section.settings.show_country, show_language: section.settings.show_language %}
      </div>

      <div class="sh-ft__base">
        <div class="sh-ft__legal">
          <p>
            &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
            {%- if settings.show_credit %}
              <span aria-hidden="true">&middot;</span>
              <a href="https://zeronkit.com" rel="noopener">{{ 'footer.credit' | t }}</a>
            {%- endif -%}
            {%- if section.settings.show_powered_by %} <span aria-hidden="true">&middot;</span> {{ powered_by_link }}{% endif %}
          </p>
          {%- if section.settings.show_policies and shop.policies.size > 0 -%}
            <ul class="sh-ft__policies" role="list" aria-label="{{ 'footer.policies' | t }}">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
        {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
          <ul class="sh-ft__payments" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'st-payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if section.settings.show_signature -%}
        <p class="sh-ft__signature" aria-hidden="true">{{ shop.name | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:names.footer",
  "class": "st-shopify-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "columns", "label": "t:options.footer_columns" },
        { "value": "editorial", "label": "t:options.footer_editorial" },
        { "value": "centered", "label": "t:options.footer_centered" }
      ],
      "default": "editorial"
    },
    { "type": "checkbox", "id": "show_brand", "label": "t:labels.show_brand", "default": true },
    { "type": "richtext", "id": "brand_text", "label": "t:labels.brand_text", "default": "<p>Furniture, lighting and textiles for rooms that are lived in.</p>" },
    { "type": "text", "id": "contact_heading", "label": "t:labels.footer_contact_heading", "default": "Visit the showroom" },
    { "type": "richtext", "id": "contact_text", "label": "t:labels.footer_contact_text", "default": "<p>Monday to Friday, 9:00 to 17:00. Saturday, 10:00 to 15:00.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-2" },
    { "type": "checkbox", "id": "show_social", "label": "t:labels.show_social", "default": true, "info": "t:info.social" },
    { "type": "checkbox", "id": "show_follow_on_shop", "label": "t:labels.show_follow_on_shop", "default": true, "info": "t:info.follow_on_shop" },
    { "type": "checkbox", "id": "show_country", "label": "t:labels.show_country", "default": true },
    { "type": "checkbox", "id": "show_language", "label": "t:labels.show_language", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "t:labels.show_payment", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "t:labels.show_policies", "default": true, "info": "t:info.policies" },
    { "type": "checkbox", "id": "show_signature", "label": "t:labels.show_signature", "default": true },
    { "type": "checkbox", "id": "show_powered_by", "label": "t:labels.show_powered_by", "default": false },
    { "type": "paragraph", "content": "t:info.credit" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "menu",
      "name": "t:names.menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Help" },
        { "type": "link_list", "id": "menu", "label": "t:labels.menu", "default": "footer", "info": "t:info.footer_menu" }
      ]
    },
    {
      "type": "text",
      "name": "t:names.text",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "About us" },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Tell shoppers who makes your furniture and what you stand for.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:names.newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Stay in the loop" },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>New arrivals and restocks, once in a while.</p>" },
        { "type": "paragraph", "content": "t:info.newsletter" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "blocks": [{ "type": "menu" }, { "type": "newsletter" }]
    }
  ]
}
{% endschema %}
