{%- comment -%} Shanasheel theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- comment -%}
  Header with five layouts: inline, center_below, split, minimal, editorial.
  The navigator (a dialog) is the mega menu on desktop and the drawer on mobile.
  When the chosen menu is empty, navigation is built from the store: collections, blog and key pages.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
  assign logo_position = section.settings.logo_position
  if layout == 'split' or layout == 'editorial' or layout == 'side'
    assign logo_position = 'center'
  endif
  assign menu = section.settings.menu
  assign nav_label = section.settings.navigator_label
  if nav_label == blank
    assign nav_label = 'header.shop' | t
  endif
  assign key_pages = 'about-us,faq,contact' | split: ','
  assign nav_label_down = nav_label | downcase | strip
  assign logo_tag = 'p'
  if request.page_type == 'index'
    assign logo_tag = 'h1'
  endif
  assign transparent = false
  if section.settings.transparent_home and request.page_type == 'index'
    assign transparent = true
  endif

  # Store collections with products, used when the menu is empty.
  assign auto_list = ''
  assign auto_count = 0
  for c in collections limit: 30
    if c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage' and auto_count < 8
      assign auto_list = auto_list | append: c.handle | append: ','
      assign auto_count = auto_count | plus: 1
    endif
  endfor
  assign auto_handles = auto_list | split: ','
  assign use_auto = false
  if menu.links.size == 0
    assign use_auto = true
  endif

  # Top level links shown in the bar. A link that repeats the navigator button is skipped.
  assign visible = ''
  for link in menu.links
    assign skip = false
    if section.settings.show_navigator and layout != 'minimal'
      assign title_down = link.title | downcase | strip
      if forloop.first and section.settings.hide_first_item
        assign skip = true
      elsif title_down == nav_label_down
        assign skip = true
      elsif link.url == routes.all_products_collection_url and link.links.size == 0
        assign skip = true
      endif
    endif
    unless skip
      assign visible = visible | append: forloop.index | append: ','
    endunless
  endfor
  assign visible_indexes = visible | split: ','
  assign half = visible_indexes.size | plus: 1 | divided_by: 2
-%}

{%- capture bar_links_start -%}
  {%- for link in menu.links -%}
    {%- assign index_text = forloop.index | append: '' -%}
    {%- if visible_indexes contains index_text -%}
      {%- assign position = 0 -%}
      {%- for v in visible_indexes -%}{%- if v == index_text -%}{%- assign position = forloop.index -%}{%- endif -%}{%- endfor -%}
      {%- if layout != 'split' or position <= half -%}
        <li>{%- assign panel_id = 'Nav-' | append: section.id | append: '-' | append: forloop.index -%}{% render 'header-link', link: link, panel_id: panel_id %}</li>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if use_auto -%}
    {%- if auto_handles.size > 0 -%}<li><button type="button" class="st-header__link" data-st-open="Navigator" data-st-panel="Nav-{{ section.id }}-auto" aria-haspopup="dialog">{{ 'header.collections' | t }}</button></li>{%- endif -%}
    {%- if layout != 'split' -%}
      {%- if blogs.news.articles_count > 0 -%}<li><a class="st-header__link" href="{{ blogs.news.url }}">{{ blogs.news.title | escape }}</a></li>{%- endif -%}
      {%- if pages['about-us'].title != blank -%}<li><a class="st-header__link" href="{{ pages['about-us'].url }}">{{ pages['about-us'].title | escape }}</a></li>{%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture bar_links_end -%}
  {%- if layout == 'split' -%}
    {%- for link in menu.links -%}
      {%- assign index_text = forloop.index | append: '' -%}
      {%- if visible_indexes contains index_text -%}
        {%- assign position = 0 -%}
        {%- for v in visible_indexes -%}{%- if v == index_text -%}{%- assign position = forloop.index -%}{%- endif -%}{%- endfor -%}
        {%- if position > half -%}
          <li>{%- assign panel_id = 'Nav-' | append: section.id | append: '-' | append: forloop.index -%}{% render 'header-link', link: link, panel_id: panel_id %}</li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if use_auto -%}
      {%- if blogs.news.articles_count > 0 -%}<li><a class="st-header__link" href="{{ blogs.news.url }}">{{ blogs.news.title | escape }}</a></li>{%- endif -%}
      {%- if pages['about-us'].title != blank -%}<li><a class="st-header__link" href="{{ pages['about-us'].url }}">{{ pages['about-us'].title | escape }}</a></li>{%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture logo -%}
  <{{ logo_tag }} class="st-header__logo">
    <a href="{{ routes.root_url }}" class="st-header__logo-link">
      {%- if section.settings.logo != blank -%}
        {%- liquid
          assign logo_width = section.settings.logo_width
          if layout == 'editorial'
            assign logo_width = logo_width | times: 1.6 | round
          endif
          assign logo_width_2x = logo_width | times: 2
          assign logo_height = logo_width | divided_by: section.settings.logo.aspect_ratio | round
        -%}
        {{ section.settings.logo | image_url: width: logo_width_2x | image_tag: width: logo_width, height: logo_height, alt: shop.name, class: 'st-header__logo-img st-header__logo-img--default', loading: 'eager' }}
        {%- if transparent and section.settings.transparent_logo != blank -%}
          {{ section.settings.transparent_logo | image_url: width: logo_width_2x | image_tag: width: logo_width, alt: shop.name, class: 'st-header__logo-img st-header__logo-img--transparent', loading: 'eager' }}
        {%- endif -%}
      {%- else -%}
        <span class="st-header__wordmark st-header__wordmark--{{ section.settings.text_logo_font }}">{{ section.settings.text_logo | default: shop.name | escape }}</span>
      {%- endif -%}
    </a>
  </{{ logo_tag }}>
{%- endcapture -%}

{%- capture utility_icons -%}
  {%- if section.settings.show_search -%}
    <button type="button" class="st-icon-button" data-st-open="SearchDialog" aria-haspopup="dialog" aria-label="{{ 'header.search' | t }}">
      {% render 'icon', name: 'search' %}
    </button>
  {%- endif -%}
  {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
    <shopify-account class="st-header__account" menu="{{ section.settings.customer_account_menu | default: 'customer-account-main-menu' }}"></shopify-account>
  {%- endif -%}
  {%- if section.settings.show_cart -%}
    <a href="{{ routes.cart_url }}" class="st-icon-button st-header__cart" data-st-cart-toggle>
      {% render 'icon', name: 'bag' %}
      <span class="st-count" data-st-cart-count aria-hidden="true"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      <span class="st-visually-hidden" data-st-cart-label>{{ 'cart.title_with_count' | t: count: cart.item_count }}</span>
    </a>
  {%- endif -%}
{%- endcapture -%}

{%- capture utilities -%}
  {%- if section.settings.show_country or section.settings.show_language -%}
    <div class="st-header__locale">
      {% render 'localization', id: 'HeaderLocalization', show_country: section.settings.show_country, show_language: section.settings.show_language %}
    </div>
  {%- endif -%}
  {{ utility_icons }}
{%- endcapture -%}



{%- capture menu_button -%}
  <button type="button" class="st-header__menu{% if layout == 'side' %} st-header__menu--mobile{% else %}{% unless section.settings.show_navigator or layout == 'minimal' %} st-header__menu--mobile{% endunless %}{% endif %}" data-st-open="Navigator" aria-haspopup="dialog">
    {% render 'icon', name: 'menu' %}
    <span class="st-header__menu-label">{{ nav_label | escape }}</span>
  </button>
{%- endcapture -%}

<st-header
  class="st-header st-header--{{ layout }} st-header--shell-{{ section.settings.header_style | default: 'bar' }} st-header--logo-{{ logo_position }} st-side-{{ section.settings.side_position }} color-{{ section.settings.color_scheme }}{% if transparent %} st-header--transparent{% endif %}"
  data-sticky="{% if layout == 'side' %}none{% else %}{{ section.settings.sticky }}{% endif %}"
  style="--st-logo-w: {{ section.settings.logo_width }}px; --st-logo-w-m: {{ section.settings.logo_width_mobile }}px; --st-wordmark: {{ section.settings.text_logo_size | divided_by: 10.0 }};{% if transparent %} --st-overlay-text: {{ section.settings.transparent_text }};{% endif %}"
>
  {%- if layout == 'editorial' -%}
    <div class="st-wrap st-header__topline">
      {{ menu_button }}
      <div class="st-header__end">{{ utilities }}</div>
    </div>
    <div class="st-wrap st-header__masthead">{{ logo }}</div>
    {%- if bar_links_start != blank -%}
      <nav class="st-header__row" aria-label="{{ 'header.primary_nav' | t }}"><ul class="st-wrap st-header__links" role="list">{{ bar_links_start }}</ul></nav>
    {%- endif -%}
  {%- else -%}
    <div class="st-wrap st-header__bar">
      <div class="st-header__start">
        {{ menu_button }}
        {%- if layout == 'inline' or layout == 'split' -%}
          {%- if bar_links_start != blank -%}
            <nav class="st-header__inline" aria-label="{{ 'header.primary_nav' | t }}"><ul class="st-header__links" role="list">{{ bar_links_start }}</ul></nav>
          {%- endif -%}
        {%- endif -%}
      </div>
      {{ logo }}
      <div class="st-header__end">
        {%- if layout == 'split' and bar_links_end != blank -%}
          <nav class="st-header__inline" aria-label="{{ 'header.secondary_nav' | t }}"><ul class="st-header__links" role="list">{{ bar_links_end }}</ul></nav>
        {%- endif -%}
        {{ utilities }}
      </div>
    </div>
    {%- if layout == 'center_below' and bar_links_start != blank -%}
      <nav class="st-header__row" aria-label="{{ 'header.primary_nav' | t }}"><ul class="st-wrap st-header__links" role="list">{{ bar_links_start }}</ul></nav>
    {%- endif -%}
  {%- endif -%}

  {%- if layout == 'side' -%}
    <div class="st-side">
      {{ logo | replace: '<h1 ', '<p ' | replace: '</h1>', '</p>' }}
      {% render 'header-side-nav', menu: menu, use_auto: use_auto, auto_handles: auto_handles %}
      <div class="st-side__icons">
        {%- if section.settings.show_country or section.settings.show_language -%}
          <div class="st-header__locale">
            {% render 'localization', id: 'SideLocalization', show_country: section.settings.show_country, show_language: section.settings.show_language %}
          </div>
        {%- endif -%}
        {{ utility_icons }}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.rail_menu.links.size > 0 -%}
    <nav class="st-rail" aria-label="{{ 'header.quick_nav' | t }}">
      <ul class="st-wrap st-rail__list" role="list">
        {%- for link in section.settings.rail_menu.links -%}
          <li><a class="st-rail__pill" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</st-header>

{% render 'header-navigator', menu: menu, use_auto: use_auto, auto_handles: auto_handles, key_pages: key_pages, section_id: section.id, nav_label: nav_label, scheme: section.settings.menu_color_scheme %}

{%- if section.settings.show_search -%}
  <dialog class="st-search-dialog color-{{ section.settings.menu_color_scheme }}" id="SearchDialog" aria-label="{{ 'header.search' | t }}">
    <div class="st-wrap st-search-dialog__inner">
      {% render 'search-form', id: 'HeaderSearch', predictive: settings.predictive_search %}
      <button type="button" class="st-icon-button" data-st-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="st-wrap st-search-dialog__body">
      {% render 'search-discovery', id: 'SearchOverlay', show_products: false, heading_tag: 'p' %}
    </div>
  </dialog>
{%- endif -%}

{% schema %}
{
  "name": "t:names.header",
  "class": "st-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "select", "id": "header_style", "label": "t:labels.header_style", "options": [ { "value": "bar", "label": "t:options.header_bar" }, { "value": "floating", "label": "t:options.header_floating" } ], "default": "bar" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.header_layout",
      "options": [
        { "value": "inline", "label": "t:options.header_inline" },
        { "value": "center_below", "label": "t:options.header_center_below" },
        { "value": "split", "label": "t:options.header_split" },
        { "value": "minimal", "label": "t:options.header_minimal" },
        { "value": "editorial", "label": "t:options.header_editorial" },
        { "value": "side", "label": "t:options.header_side" }
      ],
      "default": "inline"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "t:labels.logo_position",
      "info": "t:info.logo_position",
      "options": [
        { "value": "start", "label": "t:options.position_start" },
        { "value": "center", "label": "t:options.position_center" },
        { "value": "end", "label": "t:options.position_end" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "side_position",
      "label": "t:labels.side_position",
      "options": [
        { "value": "start", "label": "t:options.position_start" },
        { "value": "end", "label": "t:options.position_end" }
      ],
      "default": "start"
    },
    { "type": "image_picker", "id": "logo", "label": "t:labels.logo" },
    { "type": "range", "id": "logo_width", "label": "t:labels.logo_width_desktop", "min": 60, "max": 300, "step": 5, "unit": "px", "default": 120 },
    { "type": "range", "id": "logo_width_mobile", "label": "t:labels.logo_width_mobile", "min": 50, "max": 200, "step": 5, "unit": "px", "default": 100 },
    { "type": "text", "id": "text_logo", "label": "t:labels.text_logo", "info": "t:info.text_logo" },
    {
      "type": "select",
      "id": "text_logo_font",
      "label": "t:labels.text_logo_font",
      "options": [
        { "value": "heading", "label": "t:options.logo_font_heading" },
        { "value": "body", "label": "t:options.logo_font_body" },
        { "value": "serif", "label": "t:options.logo_font_serif" },
        { "value": "mono", "label": "t:options.logo_font_mono" }
      ],
      "default": "heading"
    },
    { "type": "range", "id": "text_logo_size", "label": "t:labels.text_logo_size", "min": 10, "max": 40, "step": 1, "default": 16 },
    {
      "type": "select",
      "id": "sticky",
      "label": "t:labels.sticky_header",
      "options": [
        { "value": "none", "label": "t:options.sticky_none" },
        { "value": "always", "label": "t:options.sticky_always" },
        { "value": "up", "label": "t:options.sticky_up" }
      ],
      "default": "up"
    },
    { "type": "header", "content": "t:labels.navigation" },
    { "type": "link_list", "id": "menu", "label": "t:labels.menu", "default": "main-menu", "info": "t:info.nested_menu" },
    { "type": "checkbox", "id": "show_navigator", "label": "t:labels.show_navigator", "default": true, "info": "t:info.navigator" },
    { "type": "text", "id": "navigator_label", "label": "t:labels.navigator_label", "default": "Shop" },
    { "type": "checkbox", "id": "hide_first_item", "label": "t:labels.hide_first_item", "default": false, "info": "t:info.hide_first_item" },
    { "type": "link_list", "id": "rail_menu", "label": "t:labels.rail_menu", "info": "t:info.rail_menu" },
    { "type": "header", "content": "t:labels.header_icons" },
    { "type": "checkbox", "id": "show_search", "label": "t:labels.show_search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "t:labels.show_account", "default": true },
    { "type": "link_list", "id": "customer_account_menu", "label": "t:labels.customer_account_menu", "default": "customer-account-main-menu" },
    { "type": "checkbox", "id": "show_cart", "label": "t:labels.show_cart", "default": true },
    { "type": "checkbox", "id": "show_country", "label": "t:labels.show_country", "default": false },
    { "type": "checkbox", "id": "show_language", "label": "t:labels.show_language", "default": false },
    { "type": "header", "content": "t:labels.transparent_header" },
    { "type": "checkbox", "id": "transparent_home", "label": "t:labels.transparent_home", "default": false, "info": "t:info.transparent_home" },
    { "type": "color", "id": "transparent_text", "label": "t:labels.transparent_text", "default": "#FFFFFF" },
    { "type": "image_picker", "id": "transparent_logo", "label": "t:labels.transparent_logo" },
    { "type": "header", "content": "t:labels.colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "menu_color_scheme", "label": "t:labels.menu_color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
