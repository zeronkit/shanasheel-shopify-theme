{%- comment -%} Shanasheel theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- comment -%}
  Workshop to home: two columns. The start column holds the title and the steps as a vertical route joined by a
  dotted brass line, each number in a small arch. The end column holds a tall photo in an arch frame with the
  promise note and link under it. On phones the photo comes first, then the steps.
{%- endcomment -%}
{%- liquid
  assign route_image = section.settings.image
  if route_image == blank
    for c in collections limit: 20
      if c.featured_image != blank and c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage'
        assign route_image = c.featured_image
        break
      endif
    endfor
  endif
-%}
<section class="st-section sh-route color-{{ section.settings.color_scheme }}">
  <div class="st-wrap sh-route__grid">
    <div class="sh-route__main">
      {%- if section.settings.eyebrow != blank -%}<p class="sh-route__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sh-route__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ol class="sh-route__steps" role="list">
          {%- for block in section.blocks -%}
            <li class="sh-route__step" {{ block.shopify_attributes }}>
              <span class="sh-route__num" aria-hidden="true">{{ forloop.index }}</span>
              <div class="sh-route__body">
                <h3 class="sh-route__step-title"><span class="st-visually-hidden">{{ 'sections.home.step' | t: number: forloop.index }}: </span>{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}<p class="sh-route__step-text">{{ block.settings.text | escape }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
    <figure class="sh-route__aside">
      <div class="sh-route__arch">
        {%- if route_image != blank -%}
          {% render 'image', image: route_image, fallback_alt: section.settings.heading, sizes: '(min-width: 990px) 40vw, 100vw', max: 1400 %}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'st-placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.text != blank or section.settings.button_label != blank -%}
        <figcaption class="sh-route__note">
          {%- if section.settings.text != blank -%}<div class="sh-route__note-text">{{ section.settings.text }}</div>{%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a class="sh-route__link" href="{{ section.settings.button_link | default: shop.shipping_policy.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
          {%- endif -%}
        </figcaption>
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "t:names.home_delivery",
  "class": "st-shopify-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Delivery" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "From the workshop to your room" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Large pieces travel with a two person team who carry them in, set them up and take the packaging away.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image", "info": "t:info.route_image" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Delivery details" },
    { "type": "url", "id": "button_link", "label": "t:labels.link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-4" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:names.step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "info": "t:info.route_icon",
          "options": [
            { "value": "none", "label": "t:options.icon_number" },
            { "value": "tag", "label": "t:options.icon_tag" },
            { "value": "ruler", "label": "t:options.icon_ruler" },
            { "value": "truck", "label": "t:options.icon_truck" },
            { "value": "pin", "label": "t:options.icon_pin" },
            { "value": "check", "label": "t:options.icon_check" },
            { "value": "return", "label": "t:options.icon_return" },
            { "value": "gift", "label": "t:options.icon_gift" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "You order" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "We confirm your piece and a delivery window within a day." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.home_delivery",
      "blocks": [
        { "type": "step", "settings": { "icon": "tag", "title": "You order", "text": "We confirm your piece and a delivery window within a day." } },
        { "type": "step", "settings": { "icon": "ruler", "title": "It is made or checked", "text": "Made to order pieces take a few weeks, stock pieces are checked by hand." } },
        { "type": "step", "settings": { "icon": "truck", "title": "Carried to the room", "text": "A two person team brings it inside, to the room you choose." } },
        { "type": "step", "settings": { "icon": "check", "title": "Set up and cleared", "text": "We assemble it and take every bit of packaging with us." } }
      ]
    }
  ]
}
{% endschema %}
