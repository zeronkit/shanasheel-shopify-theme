{%- comment -%}
  Workshop to home: numbered delivery steps on a line (order, made, delivered to the room, set up),
  with an optional promise note and link at the start.
{%- endcomment -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
<section class="st-section st-journey color-{{ section.settings.color_scheme }}">
  <div class="st-wrap st-journey__grid">
    <div class="st-journey__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="st-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="st-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="st-rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="st-button st-button--ghost" href="{{ section.settings.button_link | default: shop.shipping_policy.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="st-journey__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="st-journey__step st-reveal" style="--st-i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <span class="st-journey__marker" aria-hidden="true">
              {%- if block.settings.icon == 'none' -%}{{ forloop.index }}{%- else -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
            </span>
            <p class="st-journey__count">{{ 'sections.home.step' | t: number: forloop.index }}</p>
            <h3 class="st-h4">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p class="st-small st-muted">{{ block.settings.text | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.home_delivery",
  "class": "st-shopify-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Delivery" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "From the workshop to your room" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Large pieces travel with a two person team who carry them in, set them up and take the packaging away.</p>" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Delivery details" },
    { "type": "url", "id": "button_link", "label": "t:labels.link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-4" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:names.step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "none", "label": "t:options.icon_number" },
            { "value": "tag", "label": "t:options.icon_tag" },
            { "value": "ruler", "label": "t:options.icon_ruler" },
            { "value": "truck", "label": "t:options.icon_truck" },
            { "value": "pin", "label": "t:options.icon_pin" },
            { "value": "check", "label": "t:options.icon_check" },
            { "value": "return", "label": "t:options.icon_return" },
            { "value": "gift", "label": "t:options.icon_gift" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "You order" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "We confirm your piece and a delivery window within a day." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.home_delivery",
      "blocks": [
        { "type": "step", "settings": { "icon": "tag", "title": "You order", "text": "We confirm your piece and a delivery window within a day." } },
        { "type": "step", "settings": { "icon": "ruler", "title": "It is made or checked", "text": "Made to order pieces take a few weeks, stock pieces are checked by hand." } },
        { "type": "step", "settings": { "icon": "truck", "title": "Carried to the room", "text": "A two person team brings it inside, to the room you choose." } },
        { "type": "step", "settings": { "icon": "check", "title": "Set up and cleared", "text": "We assemble it and take every bit of packaging with us." } }
      ]
    }
  ]
}
{% endschema %}
