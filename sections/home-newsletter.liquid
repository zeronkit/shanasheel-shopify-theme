{%- comment -%}
  Newsletter as a rounded card: a photo window on one side and the sign up form on the other.
  Without a chosen image it uses a store product photo, or hides the window when there is none.
{%- endcomment -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign image = section.settings.image
  if image == blank and section.settings.show_image
    for candidate in collections.all.products limit: 10
      if candidate.featured_media
        assign image = candidate.featured_media.preview_image
        break
      endif
    endfor
  endif
  assign form_id = 'Newsletter-' | append: section.id
-%}
<section class="st-section st-letter-section">
  <div class="st-wrap">
    <div class="st-letter color-{{ section.settings.color_scheme }}{% if section.settings.show_image and image != blank %} st-letter--image{% endif %}">
      {%- if section.settings.show_image and image != blank -%}
        <div class="st-letter__media">
          {% render 'image', image: image, sizes: '(min-width: 990px) 40vw, 100vw', max: 1500, alt: '' %}
        </div>
      {%- endif -%}
      <div class="st-letter__body">
        {%- if section.settings.eyebrow != blank -%}<p class="st-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="st-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="st-rte">{{ section.settings.text }}</div>{%- endif -%}
        {% render 'newsletter-form', id: form_id %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.home_newsletter",
  "class": "st-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Letters from home" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "New pieces, restocks and room ideas" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>One calm email a month. Unsubscribe any time.</p>" },
    { "type": "paragraph", "content": "t:info.newsletter" },
    { "type": "checkbox", "id": "show_image", "label": "t:labels.show_image", "default": true },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-5" }
  ],
  "presets": [{ "name": "t:names.home_newsletter" }]
}
{% endschema %}
