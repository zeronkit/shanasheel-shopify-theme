{%- comment -%}
  Shop by room: one large room tile and smaller ones around it, names sit on a soft label.
  Blocks without a collection (or no blocks at all) use the store collections that have products.
{%- endcomment -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign auto_list = ''
  for c in collections limit: 30
    if c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage'
      assign auto_list = auto_list | append: c.handle | append: ','
    endif
  endfor
  assign auto_handles = auto_list | split: ','
  assign auto_index = 0
  assign tile_count = section.blocks.size
  if tile_count == 0
    assign tile_count = auto_handles.size | at_most: 5
  endif
  # A new store with no collections still shows five placeholder tiles.
  if tile_count == 0
    assign tile_count = 5
  endif
-%}
<section class="st-section st-rooms st-rooms--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}">
  <div class="st-wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="st-section__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="st-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="st-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}<div class="st-rte st-muted st-rooms__intro">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="st-rooms__grid" role="list" style="--tiles: {{ tile_count }};">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign room = block.settings.collection
            if room == blank and auto_handles[auto_index] != blank
              assign room = collections[auto_handles[auto_index]]
              assign auto_index = auto_index | plus: 1
            endif
          -%}
          <li class="st-room st-reveal" style="--st-i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            {% render 'home-room-tile', room: room, image: block.settings.image, title: block.settings.title, index: forloop.index0, show_count: section.settings.show_count %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..tile_count) -%}
          {%- assign room = collections[auto_handles[forloop.index0]] -%}
          <li class="st-room st-reveal" style="--st-i: {{ forloop.index0 }};">
            {% render 'home-room-tile', room: room, index: forloop.index0, show_count: section.settings.show_count %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:names.home_rooms",
  "class": "st-shopify-section",
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Shop by room" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Start with the room you live in most" },
    { "type": "richtext", "id": "text", "label": "t:labels.text" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "mosaic", "label": "t:options.mosaic" },
        { "value": "row", "label": "t:options.horizontal" }
      ],
      "default": "mosaic"
    },
    { "type": "checkbox", "id": "show_count", "label": "t:labels.show_count", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "t:names.room",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:labels.collection" },
        { "type": "text", "id": "title", "label": "t:labels.title_override" },
        { "type": "image_picker", "id": "image", "label": "t:labels.image_override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.home_rooms",
      "blocks": [{ "type": "room" }, { "type": "room" }, { "type": "room" }, { "type": "room" }, { "type": "room" }]
    }
  ]
}
{% endschema %}
