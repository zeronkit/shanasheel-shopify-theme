{%- comment -%}
  Product shelf: an intro column with the arrows, and a scroll row of products standing on a shelf line.
  Uses the shared st-slider (assets/slider.js) and snippets/product-card.
{%- endcomment -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign collection = section.settings.collection
  if collection != blank
    assign products = collection.products
  else
    # No collection chosen: show the newest products of the whole store.
    assign collection = collections.all
    assign products = collections.all.products | sort: 'published_at' | reverse
  endif
  assign heading = section.settings.heading | default: collection.title
-%}
<section class="st-section st-shelf st-shelf--{{ section.settings.card_width }} color-{{ section.settings.color_scheme }}">
  <st-slider class="st-wrap st-slider st-shelf__inner">
    <div class="st-shelf__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="st-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="st-h2">{{ heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="st-rte st-muted">{{ section.settings.text }}</div>{%- endif -%}
      <div class="st-section__actions">
        {%- if section.settings.show_arrows -%}
          {% render 'slider-controls', label: heading %}
        {%- endif -%}
        {%- if section.settings.show_view_all -%}
          <a class="st-button st-button--text" href="{{ collection.url }}">
            {{ 'collections.view_all' | t }}<span class="st-visually-hidden">: {{ collection.title | escape }}</span> {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    </div>
    <div class="st-shelf__board">
      <ul class="st-grid st-grid--rail st-shelf__track" role="list" data-st-slider-track>
        {%- if products.size > 0 -%}
          {%- for product in products limit: section.settings.limit -%}
            <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 22vw, 70vw' %}</li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>{% render 'product-card', product: blank, placeholder_index: i %}</li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </st-slider>
</section>

{% schema %}
{
  "name": "t:names.home_shelf",
  "class": "st-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Just in" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "New on the shelf" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>The latest pieces from our makers, ready to ship.</p>" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 3, "max": 16, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "card_width",
      "label": "t:labels.card_width",
      "options": [
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" }
      ],
      "default": "medium"
    },
    { "type": "checkbox", "id": "show_arrows", "label": "t:labels.show_arrows_rail", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "t:labels.show_view_all", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:names.home_shelf" }]
}
{% endschema %}
