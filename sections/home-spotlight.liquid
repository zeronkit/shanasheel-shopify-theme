{%- comment -%}
  Piece in focus: one room photograph of the piece across the content width (16:7), with a raised buy card over
  its lower end corner (eyebrow, name, price, finishes, quantity, Add to cart, View full details). The short facts
  (lead time, assembly, care) run as a brass ruled line under the photo. On phones the card is pulled up over the
  bottom edge of the photo and the facts follow as a list. The buy logic is the shared st-product from assets/product.js.
{%- endcomment -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign product = section.settings.product
  if product == blank
    for candidate in collections.all.products limit: 20
      if candidate.available
        assign product = candidate
        break
      endif
    endfor
  endif
  assign variant = product.selected_or_first_available_variant
  assign room_image = section.settings.image
  if room_image == blank
    assign room_image = product.featured_media.preview_image
  endif
  assign corner = section.settings.media_side | default: 'end'
-%}
<section class="st-section st-featured-product sh-focus sh-focus--card-{{ corner }} color-{{ section.settings.color_scheme }}">
  {%- if product != blank -%}
    <st-product class="st-wrap sh-focus__grid" data-section-id="{{ section.id }}" data-url="{{ product.url }}">
      <div class="sh-focus__photo">
        {%- if room_image != blank -%}
          {% render 'image', image: room_image, fallback_alt: product.title, sizes: '(min-width: 1400px) 1320px, 100vw', max: 2400 %}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'st-placeholder' }}
        {%- endif -%}
      </div>
      <div class="st-product__info sh-focus__card">
        {%- if section.settings.eyebrow != blank -%}<p class="sh-focus__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="sh-focus__name"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
        <div data-st-swap="price-featured">{% render 'price', product: product, variant: variant, class: 'st-price--large' %}</div>
        {%- if section.settings.show_description and product.description != blank -%}
          <p class="sh-focus__text">{{ product.description | strip_html | truncatewords: 18 }}</p>
        {%- endif -%}
        <div data-st-swap="picker-featured" data-variant-id="{{ variant.id }}" data-variant-media="{{ variant.featured_media.id }}">
          {% render 'variant-picker', product: product, section_id: section.id, style: 'chips' %}
        </div>
        <div data-st-swap="buy-featured">
          {% render 'buy-form', product: product, variant: variant, section_id: section.id, show_checkout: section.settings.show_dynamic_checkout, show_pickup: false, show_quantity: true %}
        </div>
        <a class="sh-focus__more" href="{{ product.url }}">{{ 'products.view_details' | t }}<span class="st-visually-hidden">: {{ product.title | escape }}</span> {% render 'icon', name: 'arrow' %}</a>
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="sh-focus__facts">
          {%- for block in section.blocks -%}
            <div class="sh-focus__fact" {{ block.shopify_attributes }}>
              <dt>{%- unless block.settings.icon == 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endunless -%}{{ block.settings.label | escape }}</dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </st-product>
  {%- else -%}
    <div class="st-wrap sh-focus__grid">
      <div class="sh-focus__photo">{{ 'product-1' | placeholder_svg_tag: 'st-placeholder' }}</div>
      <div class="sh-focus__card">
        <h2 class="sh-focus__name">{{ 'products.placeholder_title' | t }}</h2>
        <p class="sh-focus__text">{{ 'products.placeholder_help' | t }}</p>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:names.home_spotlight",
  "class": "st-shopify-section",
  "max_blocks": 4,
  "settings": [
    { "type": "product", "id": "product", "label": "t:labels.product" },
    { "type": "image_picker", "id": "image", "label": "t:labels.room_photo", "info": "t:info.room_photo" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Piece in focus" },
    { "type": "checkbox", "id": "show_description", "label": "t:labels.show_description", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:labels.show_dynamic_checkout", "default": false },
    {
      "type": "select",
      "id": "media_side",
      "label": "t:labels.card_corner",
      "options": [
        { "value": "start", "label": "t:options.position_start" },
        { "value": "end", "label": "t:options.position_end" }
      ],
      "default": "end"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "t:names.fact",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "none", "label": "t:options.icon_none" },
            { "value": "truck", "label": "t:options.icon_truck" },
            { "value": "ruler", "label": "t:options.icon_ruler" },
            { "value": "spark", "label": "t:options.icon_spark" },
            { "value": "return", "label": "t:options.icon_return" },
            { "value": "check", "label": "t:options.icon_check" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "label", "label": "t:labels.fact_label", "default": "Lead time" },
        { "type": "text", "id": "value", "label": "t:labels.fact_value", "default": "Ships in 2 to 3 weeks" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.home_spotlight",
      "blocks": [
        { "type": "fact", "settings": { "icon": "truck", "label": "Lead time", "value": "Ships in 2 to 3 weeks" } },
        { "type": "fact", "settings": { "icon": "ruler", "label": "Assembly", "value": "Legs screw on, no tools" } },
        { "type": "fact", "settings": { "icon": "spark", "label": "Care", "value": "Removable, washable covers" } }
      ]
    }
  ]
}
{% endschema %}
