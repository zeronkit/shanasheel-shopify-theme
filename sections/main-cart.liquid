{%- comment -%}
  Cart page, "delivery to your room": full width room cards (a large arched photo, the details with the delivery
  estimate, quantity and price at the end), then a walnut band with the delivery meter, subtotal, checkout and the
  three delivery promises. The band stays at the bottom of the window while the cards scroll. On phones it is a
  bar with the subtotal and checkout, the note and the promises open from Details.
  An empty cart shows the rooms bento and a few pieces, so it is never a dead end.
{%- endcomment -%}
{%- liquid
  assign form_id = 'CartForm-' | append: section.id
  assign empty_heading = section.settings.empty_heading
  if empty_heading == blank
    assign empty_heading = 'cart.empty' | t
  endif
-%}
{%- liquid
  assign t_assurance_1 = 'sh_cart.assurance_1' | t
  if section.settings.assurance_1 != blank
    assign t_assurance_1 = section.settings.assurance_1
  endif
  assign t_assurance_2 = 'sh_cart.assurance_2' | t
  if section.settings.assurance_2 != blank
    assign t_assurance_2 = section.settings.assurance_2
  endif
  assign t_assurance_3 = 'sh_cart.assurance_3' | t
  if section.settings.assurance_3 != blank
    assign t_assurance_3 = section.settings.assurance_3
  endif
-%}
<section class="st-section color-{{ section.settings.color_scheme }}">
  <st-cart class="st-wrap st-cart" data-section-id="{{ section.id }}">
    <div data-st-cart-content data-count="{{ cart.item_count }}" data-count-label="{{ 'cart.title_with_count' | t: count: cart.item_count }}">
      <div class="st-cart__head">
        <h1 class="st-h2">
          {{- 'cart.title' | t -}}
          {%- if cart.item_count > 0 %} <span class="st-count" aria-hidden="true">{{ cart.item_count }}</span>{% endif -%}
        </h1>
        <a class="st-link-button" href="{{ routes.all_products_collection_url }}">{% render 'icon', name: 'back' %}{{ 'cart.continue' | t }}</a>
      </div>
      {%- if cart.item_count > 0 -%}
        <div class="sh-cartroom">
          <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="sh-cartroom__lines" novalidate>
            {% render 'cart-lines', section_id: section.id, layout: 'room' %}
            <noscript><button type="submit" class="st-button st-button--ghost" name="update">{{ 'cart.update' | t }}</button></noscript>
          </form>
          <div class="sh-cartband" data-sh-band>
            <h2 class="st-visually-hidden">{{ 'cart.summary' | t }}</h2>
            {% render 'cart-summary', form_id: form_id, show_note: false %}
            <button type="button" class="sh-cartband__toggle" aria-expanded="false" aria-controls="CartBandMore-{{ section.id }}" data-sh-band-toggle>
              <span>{{ 'sh_layout.cart_details' | t }}</span>{% render 'icon', name: 'down' %}
            </button>
            <div class="sh-cartband__more" id="CartBandMore-{{ section.id }}">
              {%- if settings.cart_note -%}
                <details class="st-fold sh-cartband__note"{% if cart.note != blank %} open{% endif %}>
                  <summary class="st-fold__summary"><span>{{ 'cart.note' | t }}</span>{% render 'icon', name: 'plus' %}</summary>
                  <label class="st-visually-hidden" for="{{ form_id }}-note">{{ 'cart.note' | t }}</label>
                  <textarea class="st-input" id="{{ form_id }}-note" name="note" form="{{ form_id }}" rows="3" data-st-note>{{ cart.note }}</textarea>
                </details>
              {%- endif -%}
              {%- if section.settings.show_assurances -%}
                {%- liquid
                  assign a1 = t_assurance_1
                  assign a2 = t_assurance_2
                  assign a3 = t_assurance_3
                -%}
                {%- if a1 != blank or a2 != blank or a3 != blank -%}
                  <ul class="sh-cartband__promises" role="list">
                    {%- if a1 != blank -%}<li>{% render 'icon', name: 'truck' %}<span>{{ a1 }}</span></li>{%- endif -%}
                    {%- if a2 != blank -%}<li>{% render 'icon', name: 'cube' %}<span>{{ a2 }}</span></li>{%- endif -%}
                    {%- if a3 != blank -%}<li>{% render 'icon', name: 'return' %}<span>{{ a3 }}</span></li>{%- endif -%}
                  </ul>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="st-cart-empty">
          <div class="st-cart-empty__intro">
            <svg viewBox="0 0 160 100" width="160" height="100" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M30 52c0-8 6-14 14-14h72c8 0 14 6 14 14v8H30z"/>
              <path d="M22 60h116v18H22z"/>
              <path d="M22 60c-6 0-10 4-10 10v8h10M138 60c6 0 10 4 10 10v8h-10"/>
              <path d="M34 78v10M126 78v10"/>
              <path d="M80 38v22" opacity="0.5"/>
            </svg>
            <h2 class="st-h3">{{ empty_heading | escape }}</h2>
            {%- liquid
              assign empty_text = section.settings.empty_text
              if empty_text == blank
                assign empty_text = 'sh_cart.empty_text' | t | prepend: '<p>' | append: '</p>'
              endif
            -%}
            <div class="st-rte st-muted">{{ empty_text }}</div>
            <a class="st-button st-button--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
          </div>

          {%- if section.settings.show_empty_rooms -%}
            {%- liquid
              assign room_handles = ''
              assign room_count = 0
              for c in collections limit: 40
                if room_count < 5 and c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage'
                  assign room_handles = room_handles | append: c.handle | append: ','
                  assign room_count = room_count | plus: 1
                endif
              endfor
              assign room_handles = room_handles | split: ','
            -%}
            {%- if room_handles.size > 0 -%}
              {{ 'home.css' | asset_url | stylesheet_tag }}
              <div class="st-cart-empty__block st-rooms st-rooms--mosaic sh-cart-rooms">
                <h2 class="st-h4">{{ 'cart.empty_rooms' | t }}</h2>
                <ul class="st-rooms__grid" role="list" style="--tiles: {{ room_handles.size }};">
                  {%- for handle in room_handles -%}
                    <li class="st-room">{% render 'home-room-tile', room: collections[handle], index: forloop.index0, show_count: true %}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.show_empty_products -%}
            {%- liquid
              if section.settings.empty_collection != blank
                assign picks = section.settings.empty_collection.products
              else
                assign picks = collections.all.products | sort: 'published_at' | reverse
              endif
            -%}
            {%- if picks.size > 0 -%}
              <div class="st-cart-empty__block">
                <h2 class="st-h4">{{ 'search.you_may_like' | t }}</h2>
                <ul class="st-grid st-grid--4 st-grid--m2" role="list">
                  {%- for product in picks limit: 4 -%}
                    <li>{% render 'product-card', product: product %}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </st-cart>
</section>

{% schema %}
{
  "name": "t:names.cart",
  "class": "st-shopify-section",
  "enabled_on": {
    "templates": [
      "cart"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:labels.delivery_notes"
    },
    {
      "type": "checkbox",
      "id": "show_assurances",
      "label": "t:labels.show_delivery_notes",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "assurance_1",
      "label": "t:labels.delivery_note_1"
    },
    {
      "type": "inline_richtext",
      "id": "assurance_2",
      "label": "t:labels.delivery_note_2"
    },
    {
      "type": "inline_richtext",
      "id": "assurance_3",
      "label": "t:labels.delivery_note_3"
    },
    {
      "type": "header",
      "content": "t:labels.empty_cart"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "empty_text",
      "label": "t:labels.text"
    },
    {
      "type": "checkbox",
      "id": "show_empty_rooms",
      "label": "t:labels.show_empty_rooms",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_empty_products",
      "label": "t:labels.show_empty_products",
      "default": true
    },
    {
      "type": "collection",
      "id": "empty_collection",
      "label": "t:labels.collection",
      "info": "t:info.empty_collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
