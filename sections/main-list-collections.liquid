{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'collections.all_title' | t
  endif
-%}
{%- liquid
  assign t_eyebrow = 'sh_rooms.eyebrow' | t
  if section.settings.eyebrow != blank
    assign t_eyebrow = section.settings.eyebrow
  endif
-%}
<section class="st-section st-rooms-index color-{{ section.settings.color_scheme }}">
  <div class="st-wrap">
    <header class="st-rooms-index__head">
      {%- if t_eyebrow != blank -%}<p class="st-eyebrow">{{ t_eyebrow | escape }}</p>{%- endif -%}
      <h1 class="st-h1">{{ heading | escape }}</h1>
      {%- if section.settings.intro != blank -%}<div class="st-rte st-muted">{{ section.settings.intro }}</div>{%- endif -%}
    </header>
    {%- paginate collections by 24 -%}
      <ul class="st-grid st-grid--{{ section.settings.columns }} st-grid--m2" role="list">
        {%- for collection in collections -%}
          <li>{% render 'collection-card', collection: collection, placeholder_index: forloop.index %}</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.collections_list",
  "class": "st-shopify-section",
  "enabled_on": {
    "templates": [
      "list-collections"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
