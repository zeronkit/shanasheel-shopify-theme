<section class="st-section st-password color-{{ section.settings.color_scheme }}">
  <div class="st-wrap st-wrap--narrow st-center">
    <p class="st-header__wordmark">{{ shop.name | escape }}</p>
    {%- if shop.password_message != blank -%}
      <h1 class="st-h2">{{ shop.password_message | escape }}</h1>
    {%- else -%}
      <h1 class="st-h2">{{ 'password.opening_soon' | t }}</h1>
    {%- endif -%}
    {%- if section.settings.show_newsletter -%}
      <p>{{ 'password.newsletter' | t }}</p>
      {% render 'newsletter-form', id: 'PasswordNewsletter' %}
    {%- endif -%}

    <details class="st-fold st-password__entry">
      <summary class="st-fold__summary"><span>{{ 'password.enter' | t }}</span>{% render 'icon', name: 'plus' %}</summary>
      <div class="st-fold__body">
        {%- form 'storefront_password', class: 'st-form' -%}
          {%- if form.errors -%}
            <div class="st-notice st-notice--error" role="alert">{{ form.errors | default_errors }}</div>
            <script>document.currentScript.closest('details').open = true;</script>
          {%- endif -%}
          <div class="st-newsletter__field">
            <label class="st-visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
            <input class="st-input" type="password" id="StorePassword" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" required>
            <button type="submit" class="st-button st-button--primary">{{ 'password.submit' | t }}</button>
          </div>
        {%- endform -%}
        <p class="st-small st-muted">{{ 'password.owner_html' | t: link: '/admin' }}</p>
      </div>
    </details>
    <p class="st-small">{{ 'password.powered_by_html' | t: shopify: powered_by_link }}</p>
  </div>
</section>

{% schema %}
{
  "name": "t:names.password",
  "class": "st-shopify-section",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "t:labels.show_newsletter", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
