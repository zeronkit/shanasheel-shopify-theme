{%- comment -%}
  Password page, "the workshop door": a split screen. The start half is a full height photo framed by a tall arch
  (the chosen image, else the photo of the first collection, else the store cover image, else a drawn lattice window).
  The end half holds the name plaque, the message, the "Enter with password" fold and the newsletter field.
  On phones the arch becomes a band at the top and the content follows.
{%- endcomment -%}
{%- liquid
  assign door_image = section.settings.image
  if door_image == blank
    for c in collections limit: 10
      if c.featured_image != blank and c.handle != 'all' and c.handle != 'frontpage'
        assign door_image = c.featured_image
        break
      endif
    endfor
  endif
  if door_image == blank
    assign door_image = shop.brand.cover_image
  endif
-%}
<section class="sh-pass color-{{ section.settings.color_scheme }}">
  <div class="sh-pass__art">
    <div class="sh-pass__arch">
      {%- if door_image != blank -%}
        {% render 'image', image: door_image, sizes: '(min-width: 750px) 50vw, 100vw', max: 1800, alt: '', eager: true %}
      {%- else -%}
        <svg class="sh-pass__window" viewBox="0 0 200 300" fill="none" aria-hidden="true" focusable="false">
          <path d="M20 290V100a80 80 0 0 1 160 0v190" stroke="#C9A36A" stroke-width="2"/>
          <path d="M100 20v270M20 160h160M20 225h160" stroke="#C9A36A" stroke-width="1.5" opacity="0.6"/>
          <path d="M40 160l20-20 20 20 20-20 20 20 20-20 20 20M40 225l20-20 20 20 20-20 20 20 20-20 20 20" stroke="#D8BC86" stroke-width="1.5"/>
        </svg>
      {%- endif -%}
    </div>
  </div>

  <div class="sh-pass__content">
    <p class="sh-pass__plaque">
      {%- if shop.brand.logo != blank -%}
        {{ shop.brand.logo | image_url: width: 360 | image_tag: alt: shop.name, width: 180, class: 'sh-pass__logo' }}
      {%- else -%}
        <span>{{ shop.name | escape }}</span>
      {%- endif -%}
    </p>
    <h1 class="sh-pass__message">
      {%- if shop.password_message != blank -%}{{ shop.password_message | escape }}{%- else -%}{{ 'password.opening_soon' | t }}{%- endif -%}
    </h1>

    <details class="sh-pass__entry">
      <summary class="sh-pass__entry-summary"><span>{{ 'password.enter' | t }}</span>{% render 'icon', name: 'plus' %}</summary>
      <div class="sh-pass__entry-body">
        {%- form 'storefront_password', class: 'st-form' -%}
          {%- if form.errors -%}
            <div class="st-notice st-notice--error" role="alert">{{ form.errors | default_errors }}</div>
            <script>document.currentScript.closest('details').open = true;</script>
          {%- endif -%}
          <div class="sh-pass__field">
            <label class="st-visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
            <input class="st-input" type="password" id="StorePassword" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" required>
            <button type="submit" class="sh-pass__button">{{ 'password.submit' | t }}</button>
          </div>
        {%- endform -%}
        <p class="sh-pass__small">{{ 'password.owner_html' | t: link: '/admin' }}</p>
      </div>
    </details>

    {%- if section.settings.show_newsletter -%}
      <div class="sh-pass__news">
        <p class="sh-pass__news-text">{{ 'password.newsletter' | t }}</p>
        {% render 'newsletter-form', id: 'PasswordNewsletter' %}
      </div>
    {%- endif -%}

    <p class="sh-pass__small sh-pass__powered">{{ 'password.powered_by_html' | t: shopify: powered_by_link }}</p>
  </div>
</section>

{% schema %}
{
  "name": "t:names.password",
  "class": "st-shopify-section",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image", "info": "t:info.password_image" },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:labels.show_newsletter", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
