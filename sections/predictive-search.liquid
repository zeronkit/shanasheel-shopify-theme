{%- comment -%}
  Rendered by /search/suggest?section_id=predictive-search. Results are grouped:
  suggestions, products, collections, pages and articles. Every result is a listbox option.
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- assign res = predictive_search.resources -%}
  <div class="st-predictive__inner" data-st-predictive-content>
    {%- assign total = res.products.size | plus: res.collections.size | plus: res.pages.size | plus: res.articles.size | plus: res.queries.size -%}
    {%- if total > 0 -%}
      <ul class="st-predictive__list" role="listbox" aria-label="{{ 'search.suggestions' | t }}">
        {%- if res.queries.size > 0 -%}
          <li class="st-predictive__group" role="presentation">
            <p class="st-predictive__heading" id="st-ps-h-q" aria-hidden="true">{{ 'search.suggestions' | t }}</p>
            <ul role="group" aria-labelledby="st-ps-h-q">
              {%- for query in res.queries -%}
                <li role="option" id="st-ps-q-{{ forloop.index }}" aria-selected="false" class="st-predictive__query">
                  <a href="{{ query.url }}" tabindex="-1">{% render 'icon', name: 'search' %} {{ query.styled_text }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}
        {%- if res.products.size > 0 -%}
          <li class="st-predictive__group st-predictive__group--products" role="presentation">
            <p class="st-predictive__heading" id="st-ps-h-p" aria-hidden="true">{{ 'search.tab_products' | t }}</p>
            <ul role="group" aria-labelledby="st-ps-h-p">
              {%- for product in res.products limit: 4 -%}
                <li role="option" id="st-ps-p-{{ forloop.index }}" aria-selected="false" class="st-predictive__product">
                  <a href="{{ product.url }}" tabindex="-1">
                    <span class="st-predictive__thumb">
                      {%- if product.featured_media -%}
                        {% render 'image', image: product.featured_media.preview_image, sizes: '(min-width: 750px) 180px, 45vw', max: 360, alt: '' %}
                      {%- endif -%}
                    </span>
                    <span class="st-predictive__text">
                      <span class="st-predictive__title">{{ product.title | escape }}</span>
                      {% render 'price', product: product %}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}
        {%- if res.collections.size > 0 -%}
          <li class="st-predictive__group" role="presentation">
            <p class="st-predictive__heading" id="st-ps-h-c" aria-hidden="true">{{ 'header.collections' | t }}</p>
            <ul role="group" aria-labelledby="st-ps-h-c">
              {%- for collection in res.collections -%}
                <li role="option" id="st-ps-c-{{ forloop.index }}" aria-selected="false">
                  <a href="{{ collection.url }}" tabindex="-1">{{ collection.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}
        {%- if res.pages.size > 0 -%}
          <li class="st-predictive__group" role="presentation">
            <p class="st-predictive__heading" id="st-ps-h-pg" aria-hidden="true">{{ 'search.tab_pages' | t }}</p>
            <ul role="group" aria-labelledby="st-ps-h-pg">
              {%- for page in res.pages -%}
                <li role="option" id="st-ps-pg-{{ forloop.index }}" aria-selected="false">
                  <a href="{{ page.url }}" tabindex="-1">{{ page.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}
        {%- if res.articles.size > 0 -%}
          <li class="st-predictive__group" role="presentation">
            <p class="st-predictive__heading" id="st-ps-h-a" aria-hidden="true">{{ 'search.tab_articles' | t }}</p>
            <ul role="group" aria-labelledby="st-ps-h-a">
              {%- for article in res.articles -%}
                <li role="option" id="st-ps-a-{{ forloop.index }}" aria-selected="false">
                  <a href="{{ article.url }}" tabindex="-1">{{ article.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}
        <li class="st-predictive__group" role="presentation">
          <ul role="group">
            <li role="option" id="st-ps-all" aria-selected="false" class="st-predictive__all">
              <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&amp;options%5Bprefix%5D=last" tabindex="-1">{{ 'search.view_all' | t: terms: predictive_search.terms }} {% render 'icon', name: 'arrow' %}</a>
            </li>
          </ul>
        </li>
      </ul>
    {%- else -%}
      <p class="st-predictive__empty">{{ 'search.no_results_title' | t: terms: predictive_search.terms }} {{ 'search.no_results_hint' | t }}</p>
    {%- endif -%}
    <p class="st-visually-hidden" data-st-predictive-status>{{ 'search.results_count' | t: count: total }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:names.predictive_search",
  "settings": []
}
{% endschema %}
