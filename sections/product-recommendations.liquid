{%- comment -%}
  "Complete the room": Shopify's related products. On the first page load, before the
  recommendations arrive (or when Shopify has none yet), products from the same collection are shown.
{%- endcomment -%}
{%- liquid
  assign is_rail = false
  if section.settings.layout == 'rail'
    assign is_rail = true
  endif
  assign shown = 0
  capture items
    if recommendations.performed
      for rec in recommendations.products
        echo '<li>'
        render 'product-card', product: rec
        echo '</li>'
      endfor
    else
      assign source = section.settings.fallback_collection | default: product.collections.first
      for item in source.products limit: 24
        if item.id == product.id
          continue
        endif
        if shown >= section.settings.limit
          break
        endif
        assign shown = shown | plus: 1
        echo '<li>'
        render 'product-card', product: item
        echo '</li>'
      endfor
    endif
  endcapture
-%}
<section class="st-section st-related color-{{ section.settings.color_scheme }}">
  <st-recommendations
    class="st-wrap"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
  >
    {%- if items != blank -%}
      <st-slider class="st-slider">
        <div class="st-section__head">
          <div>
            {%- if section.settings.eyebrow != blank -%}<p class="st-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
            <h2 class="st-h2">{{ section.settings.heading | escape }}</h2>
          </div>
          {%- if is_rail and section.settings.show_arrows -%}
            <div class="st-section__actions">
              {% render 'slider-controls', label: section.settings.heading %}
            </div>
          {%- endif -%}
        </div>
        <ul class="st-grid st-grid--{{ section.settings.columns }} st-grid--m2{% if is_rail %} st-grid--rail{% endif %}" role="list"{% if is_rail %} data-st-slider-track{% endif %}>
          {{ items }}
        </ul>
        {%- if is_rail -%}
          <span class="st-slider__progress" data-st-slider-progress hidden aria-hidden="true"><span></span></span>
        {%- endif -%}
      </st-slider>
    {%- endif -%}
  </st-recommendations>
</section>

{% schema %}
{
  "name": "t:names.related_products",
  "class": "st-shopify-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "t:info.related" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Styled together" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Complete the room" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "rail", "label": "t:options.scroll_rail" },
        { "value": "grid", "label": "t:options.grid" }
      ],
      "default": "rail"
    },
    { "type": "checkbox", "id": "show_arrows", "label": "t:labels.show_arrows_rail", "default": true },
    { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 2, "max": 10, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "t:labels.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "collection", "id": "fallback_collection", "label": "t:labels.fallback_collection", "info": "t:info.related_fallback" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "t:names.related_products" }]
}
{% endschema %}
