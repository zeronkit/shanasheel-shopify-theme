      "label": "Email label"
    },
    {
      "type": "text",
      "id": "order_label",
      "label": "Order label"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message"
    },
    {
      "type": "header",
      "content": "Workshop card"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Card heading"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Hours"
    }
