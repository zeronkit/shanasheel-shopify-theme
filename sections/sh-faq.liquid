{%- comment -%}
  FAQ, "workshop questions": a narrow walnut strip with the title and an "Ask the workshop" link, then two columns.
  The start column holds the questions as folds, grouped under their topic (consecutive questions with the same
  topic share one heading). The end column holds a sticky arched card with the showroom hours and a Contact button.
  Questions come from the section blocks. Without blocks the page text is shown as it is.
{%- endcomment -%}
{%- liquid
  assign contact_url = section.settings.link | default: pages.contact.url | default: routes.root_url
  assign link_label = section.settings.link_label
  if link_label == blank
    assign link_label = 'sh_layout.faq_ask' | t
  endif
  assign card_heading = section.settings.card_heading
  if card_heading == blank
    assign card_heading = 'sh_layout.faq_card_title' | t
  endif
  assign card_button = section.settings.card_button
  if card_button == blank
    assign card_button = 'sh_layout.faq_card_button' | t
  endif
-%}
<section class="sh-faq color-{{ section.settings.color_scheme }}">
  <div class="st-wrap">
    <header class="sh-faq__strip">
      <h1 class="sh-faq__title">{{ page.title | escape }}</h1>
      <a class="sh-faq__ask" href="{{ contact_url }}">{{ link_label | escape }} {% render 'icon', name: 'arrow' %}</a>
    </header>

    <div class="sh-faq__grid">
      <div class="sh-faq__list">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            # Consecutive questions with the same topic form one group under one heading.
            assign groups = ''
            assign items = ''
            assign group_head = ''
            assign last_topic = '§'
            for block in section.blocks
              assign topic = block.settings.topic | strip
              if topic != last_topic and forloop.first == false
                assign groups = groups | append: '<div class="sh-faq__topic">' | append: group_head | append: items | append: '</div>'
                assign items = ''
              endif
              if topic != last_topic
                assign group_head = ''
                if topic != blank
                  assign safe_topic = topic | escape
                  assign group_head = '<h2 class="sh-faq__topic-title">' | append: safe_topic | append: '</h2>'
                endif
                assign last_topic = topic
              endif
              capture item
                render 'sh-faq-item', block: block
              endcapture
              assign items = items | append: item
            endfor
            assign groups = groups | append: '<div class="sh-faq__topic">' | append: group_head | append: items | append: '</div>'
          -%}
          {{ groups }}
        {%- else -%}
          <div class="st-rte sh-faq__page">{{ page.content }}</div>
        {%- endif -%}
      </div>

      <aside class="sh-faq__card" aria-labelledby="FaqCard-{{ section.id }}">
        <span class="sh-faq__card-top" aria-hidden="true">{% render 'icon', name: 'pin' %}</span>
        <h2 class="sh-faq__card-title" id="FaqCard-{{ section.id }}">{{ card_heading | escape }}</h2>
        {%- if section.settings.card_text != blank -%}<div class="sh-faq__card-text">{{ section.settings.card_text }}</div>{%- endif -%}
        <a class="sh-faq__card-button" href="{{ contact_url }}">{{ card_button | escape }}</a>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.sh_faq",
  "class": "st-shopify-section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "link_label", "label": "t:labels.button_label" },
    { "type": "url", "id": "link", "label": "t:labels.link", "info": "t:info.faq_link" },
    { "type": "header", "content": "t:labels.faq_card" },
    { "type": "text", "id": "card_heading", "label": "t:labels.heading" },
    { "type": "richtext", "id": "card_text", "label": "t:labels.text" },
    { "type": "text", "id": "card_button", "label": "t:labels.button_label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:names.question",
      "settings": [
        { "type": "text", "id": "topic", "label": "t:labels.topic", "info": "t:info.faq_topic" },
        { "type": "text", "id": "question", "label": "t:labels.question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "t:labels.answer", "default": "<p>Stock pieces leave the workshop within a few days. Made to order pieces show their time on the product page.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "t:names.sh_faq" }]
}
{% endschema %}
