{%- comment -%}
  Cart line items shared by the cart page and the cart drawer.
  Params: section_id, layout
    'row'  : the drawer, one sideways row of arched item cards (a vertical list of horizontal cards on phones)
    'room' : the cart page, full width room cards (large arched photo, details with the delivery estimate, quantity and price at the end)
    blank  : the plain list
  Every line keeps data-st-line so the cart script can mark it busy while it updates.
{%- endcomment -%}
{%- liquid
  case layout
    when 'row'
      assign list_class = 'sh-rcards'
    when 'room'
      assign list_class = 'sh-roomlines'
    else
      assign list_class = 'st-lines'
  endcase
-%}
<ul class="{{ list_class }}" role="list">
  {%- for item in cart.items -%}
    {%- capture line_media -%}
      {%- if item.image -%}
        {%- if layout == 'room' -%}
          {% render 'image', image: item.image, sizes: '(min-width: 750px) 30vw, 90vw', max: 900, alt: '' %}
        {%- else -%}
          {% render 'image', image: item.image, sizes: '(min-width: 750px) 240px, 120px', max: 480, alt: '' %}
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- capture line_meta -%}
      {%- if item.product.has_only_default_variant == false or item.properties.size > 0 -%}
        <dl class="st-line__meta">
          {%- unless item.product.has_only_default_variant -%}
            {%- for option in item.options_with_values -%}
              <div><dt>{{ option.name | escape }}:</dt> <dd>{{ option.value | escape }}</dd></div>
            {%- endfor -%}
          {%- endunless -%}
          {%- for property in item.properties -%}
            {%- assign first_char = property.first | slice: 0 -%}
            {%- if property.last != blank and first_char != '_' -%}
              <div>
                <dt>{{ property.first | escape }}:</dt>
                <dd>
                  {%- if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                  {%- else -%}
                    {{ property.last | escape }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if item.selling_plan_allocation -%}
        <p class="st-line__plan st-small">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
      {%- endif -%}

      {%- comment -%} The line price shows once. Under the name only the price of one piece when there are several, or a unit price. {%- endcomment -%}
      {%- if item.quantity > 1 or item.unit_price_measurement -%}
        <p class="st-line__price st-small st-muted">
          {%- if item.quantity > 1 -%}
            {%- capture each_price -%}{{ item.final_price | money }}{%- endcapture -%}
            <span>{{ 'cart.each' | t: price: each_price }}</span>
          {%- endif -%}
          {%- if item.unit_price_measurement -%}
            <span class="st-price__unit">
              {{ item.unit_price | money }}/
              {%- if item.unit_price_measurement.reference_value != 1 -%}{{ item.unit_price_measurement.reference_value }}{%- endif -%}
              {{ item.unit_price_measurement.reference_unit }}
            </span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if item.line_level_discount_allocations.size > 0 -%}
        <ul class="st-line__discounts" role="list">
          {%- for discount in item.line_level_discount_allocations -%}
            <li class="st-discount">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endcapture -%}

    {%- capture line_qty -%}
      {%- liquid
        assign qty_label = 'cart.quantity_for' | t: title: item.product.title
        assign qty_id = 'Quantity-' | append: section_id | append: '-' | append: forloop.index
      -%}
      {% render 'quantity', id: qty_id, name: 'updates[]', value: item.quantity, min: 0, line: forloop.index, label: qty_label %}
    {%- endcapture -%}

    {%- capture line_remove -%}
      <button type="button" class="st-link-button" data-st-remove="{{ forloop.index }}">
        {{ 'cart.remove' | t }}<span class="st-visually-hidden"> {{ item.product.title | escape }}</span>
      </button>
    {%- endcapture -%}

    {%- capture line_total -%}
      {%- if item.original_line_price != item.final_line_price -%}
        <span class="st-visually-hidden">{{ 'products.price.regular' | t }}</span>
        <s class="st-muted st-small">{{ item.original_line_price | money }}</s>
        <span class="st-visually-hidden">{{ 'products.price.sale' | t }}</span>
      {%- endif -%}
      <span>{{ item.final_line_price | money }}</span>
    {%- endcapture -%}

    {%- assign line_error = '<p class="st-line__error st-small" role="alert" hidden data-st-line-error></p>' -%}

    {%- case layout -%}
      {%- when 'row' -%}
        <li class="sh-rcard" data-st-line="{{ forloop.index }}">
          <a href="{{ item.url }}" class="sh-rcard__arch" tabindex="-1" aria-hidden="true">{{ line_media }}</a>
          <div class="sh-rcard__info">
            <a class="sh-rcard__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
            {{ line_meta }}
            <p class="sh-rcard__price">{{ line_total }}</p>
            <div class="sh-rcard__controls">{{ line_qty }}{{ line_remove }}</div>
            {{ line_error }}
          </div>
        </li>
      {%- when 'room' -%}
        {%- liquid
          assign lead = item.variant.metafields.shanasheel.lead_time.value | default: item.product.metafields.shanasheel.lead_time.value
          if lead == blank and item.requires_shipping
            if item.variant.inventory_management == blank or item.variant.inventory_quantity > 0
              assign lead = 'sh_layout.cart_lead_default' | t
            endif
          endif
        -%}
        <li class="sh-roomline" data-st-line="{{ forloop.index }}">
          <a href="{{ item.url }}" class="sh-roomline__arch" tabindex="-1" aria-hidden="true">{{ line_media }}</a>
          <div class="sh-roomline__info">
            {%- if item.vendor != blank and item.vendor != shop.name -%}<p class="sh-roomline__maker">{{ item.vendor | escape }}</p>{%- endif -%}
            <a class="sh-roomline__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
            {{ line_meta }}
            {%- if lead != blank and item.product.gift_card? == false -%}
              <p class="sh-roomline__lead">{% render 'icon', name: 'truck' %}<span>{{ lead | escape }}</span></p>
            {%- endif -%}
            {{ line_error }}
          </div>
          <div class="sh-roomline__end">
            <p class="sh-roomline__price">{{ line_total }}</p>
            {{ line_qty }}
            {{ line_remove }}
          </div>
        </li>
      {%- else -%}
        <li class="st-line" data-line="{{ forloop.index }}" data-st-line="{{ forloop.index }}">
          <a href="{{ item.url }}" class="st-line__media" tabindex="-1" aria-hidden="true">{{ line_media }}</a>
          <div class="st-line__info">
            <a class="st-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
            {{ line_meta }}
            <div class="st-line__controls">{{ line_qty }}{{ line_remove }}</div>
            {{ line_error }}
          </div>
          <div class="st-line__total">{{ line_total }}</div>
        </li>
    {%- endcase -%}
  {%- endfor -%}
</ul>
