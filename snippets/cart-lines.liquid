{%- comment -%}
  Cart line items shared by the cart page and the cart drawer.
  Params: section_id
{%- endcomment -%}
<ul class="st-lines" role="list">
  {%- for item in cart.items -%}
    <li class="st-line" data-line="{{ forloop.index }}">
      <a href="{{ item.url }}" class="st-line__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {% render 'image', image: item.image, sizes: '120px', max: 240, alt: '' %}
        {%- endif -%}
      </a>

      <div class="st-line__info">
        <a class="st-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

        {%- if item.product.has_only_default_variant == false or item.properties.size > 0 -%}
          <dl class="st-line__meta">
            {%- unless item.product.has_only_default_variant -%}
              {%- for option in item.options_with_values -%}
                <div><dt>{{ option.name | escape }}:</dt> <dd>{{ option.value | escape }}</dd></div>
              {%- endfor -%}
            {%- endunless -%}
            {%- for property in item.properties -%}
              {%- assign first_char = property.first | slice: 0 -%}
              {%- if property.last != blank and first_char != '_' -%}
                <div>
                  <dt>{{ property.first | escape }}:</dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                      <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                    {%- else -%}
                      {{ property.last | escape }}
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if item.selling_plan_allocation -%}
          <p class="st-line__plan st-small">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
        {%- endif -%}

        {%- comment -%} The line price shows once, on the side. Under the name only the price of one piece when there are several, or a unit price. {%- endcomment -%}
        {%- if item.quantity > 1 or item.unit_price_measurement -%}
          <p class="st-line__price st-small st-muted">
            {%- if item.quantity > 1 -%}
              {%- capture each_price -%}{{ item.final_price | money }}{%- endcapture -%}
              <span>{{ 'cart.each' | t: price: each_price }}</span>
            {%- endif -%}
            {%- if item.unit_price_measurement -%}
              <span class="st-price__unit">
                {{ item.unit_price | money }}/
                {%- if item.unit_price_measurement.reference_value != 1 -%}{{ item.unit_price_measurement.reference_value }}{%- endif -%}
                {{ item.unit_price_measurement.reference_unit }}
              </span>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="st-line__discounts" role="list">
            {%- for discount in item.line_level_discount_allocations -%}
              <li class="st-discount">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="st-line__controls">
          {%- liquid
            assign qty_label = 'cart.quantity_for' | t: title: item.product.title
            assign qty_id = 'Quantity-' | append: section_id | append: '-' | append: forloop.index
          -%}
          {% render 'quantity',
            id: qty_id,
            name: 'updates[]',
            value: item.quantity,
            min: 0,
            line: forloop.index,
            label: qty_label
          %}
          <button type="button" class="st-link-button" data-st-remove="{{ forloop.index }}">
            {{ 'cart.remove' | t }}<span class="st-visually-hidden"> {{ item.product.title | escape }}</span>
          </button>
        </div>
        <p class="st-line__error st-small" role="alert" hidden data-st-line-error></p>
      </div>

      <div class="st-line__total">
        {%- if item.original_line_price != item.final_line_price -%}
          <span class="st-visually-hidden">{{ 'products.price.regular' | t }}</span>
          <s class="st-muted st-small">{{ item.original_line_price | money }}</s>
          <span class="st-visually-hidden">{{ 'products.price.sale' | t }}</span>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </li>
  {%- endfor -%}
</ul>
