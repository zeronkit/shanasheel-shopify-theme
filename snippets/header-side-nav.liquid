{%- comment -%}
  Vertical menu of the side header, with expandable levels.
  Params: menu, use_auto, auto_handles
{%- endcomment -%}
<nav class="st-side__nav" aria-label="{{ 'header.primary_nav' | t }}">
  <ul class="st-side__list" role="list">
    {%- if use_auto -%}
      {%- for handle in auto_handles -%}
        {%- assign c = collections[handle] -%}
        <li><a class="st-side__link" href="{{ c.url }}">{{ c.title | escape }}</a></li>
      {%- endfor -%}
      {%- if blogs.news.articles_count > 0 -%}<li><a class="st-side__link" href="{{ blogs.news.url }}">{{ blogs.news.title | escape }}</a></li>{%- endif -%}
    {%- else -%}
      {%- for link in menu.links -%}
        <li>
          {%- if link.links.size > 0 -%}
            <details{% if link.child_active or link.active %} open{% endif %}>
              <summary class="st-side__summary">{{ link.title | escape }}{% render 'icon', name: 'down' %}</summary>
              <ul class="st-side__sub" role="list">
                <li><a class="st-side__link" href="{{ link.url }}">{{ 'header.view_all_plain' | t }}<span class="st-visually-hidden">: {{ link.title | escape }}</span></a></li>
                {%- for child in link.links -%}
                  <li>
                    {%- if child.links.size > 0 -%}
                      <details{% if child.child_active or child.active %} open{% endif %}>
                        <summary class="st-side__summary">{{ child.title | escape }}{% render 'icon', name: 'down' %}</summary>
                        <ul class="st-side__sub" role="list">
                          <li><a class="st-side__link" href="{{ child.url }}">{{ 'header.view_all_plain' | t }}<span class="st-visually-hidden">: {{ child.title | escape }}</span></a></li>
                          {%- for grandchild in child.links -%}
                            <li><a class="st-side__link" href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- else -%}
                      <a class="st-side__link" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a class="st-side__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</nav>
