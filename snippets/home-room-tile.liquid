{%- comment -%}
  One room tile for sections/home-rooms.
  Params: room (collection), image (override), title (override), index, show_count
{%- endcomment -%}
{%- liquid
  assign tile_image = image
  if tile_image == blank
    assign tile_image = room.featured_image | default: room.products.first.featured_media.preview_image
  endif
  assign tile_title = title | default: room.title
  # A wide photo in a tall tile shows mostly wall or ceiling, so it is zoomed toward its subject:
  # the merchant's focal point when one is set, otherwise the lower part where furniture usually stands.
  assign media_class = ''
  assign media_style = ''
  if index > 0 and tile_image.aspect_ratio > 1.2
    assign zoom_origin = tile_image.presentation.focal_point | default: '50% 50%'
    assign zoom_check = zoom_origin | remove: '.0' | remove: ' '
    if zoom_check == '50%50%'
      assign zoom_origin = '50% 85%'
    endif
    assign media_class = ' st-room__media--zoom'
    assign sizes = '(min-width: 990px) 40vw, 80vw'
    assign media_style = ' style="--zoom-origin: ' | append: zoom_origin | append: ';"'
  endif
  if index == 0
    assign sizes = '(min-width: 990px) 50vw, 100vw'
  else
    assign sizes = '(min-width: 990px) 25vw, 50vw'
  endif
-%}
<article class="st-room__tile">
  <div class="st-room__media{{ media_class }}"{{ media_style }}>
    {%- if tile_image != blank -%}
      {% render 'image', image: tile_image, fallback_alt: tile_title, sizes: sizes, max: 1800 %}
    {%- else -%}
      {%- assign p_index = index | modulo: 6 | plus: 1 -%}
      {%- assign placeholder = 'collection-' | append: p_index -%}
      {{ placeholder | placeholder_svg_tag: 'st-placeholder' }}
    {%- endif -%}
  </div>
  <h3 class="st-room__label">
    {%- if room != blank -%}
      <a class="st-card__link" href="{{ room.url }}">{{ tile_title | escape }}</a>
      {%- if show_count -%}<span class="st-room__count">{{ 'collections.product_count' | t: count: room.all_products_count }}</span>{%- endif -%}
    {%- else -%}
      {%- assign placeholder_title = 'collections.placeholder_title' | t -%}
      <span>{{ tile_title | default: placeholder_title | escape }}</span>
    {%- endif -%}
    {% render 'icon', name: 'arrow' %}
  </h3>
</article>
