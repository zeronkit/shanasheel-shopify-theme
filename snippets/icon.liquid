{%- comment -%}
  Usage: {% render 'icon', name: 'bag' %}
  Icons that point in a reading direction get .st-icon--flip so they mirror in RTL.
{%- endcomment -%}
{%- liquid
  assign flip = ''
  if name == 'arrow' or name == 'chevron' or name == 'back'
    assign flip = ' st-icon--flip'
  endif
-%}
<svg class="st-icon st-icon--{{ name }}{{ flip }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'menu' -%}
      <path d="M3 6h18M3 12h12M3 18h18"/>
    {%- when 'close' -%}
      <path d="M5 5l14 14M19 5L5 19"/>
    {%- when 'search' -%}
      <circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/>
    {%- when 'bag' -%}
      <path d="M4.5 8h15l-1.2 12.5H5.7z"/><path d="M8.5 8V6.5a3.5 3.5 0 0 1 7 0V8"/>
    {%- when 'arrow' -%}
      <path d="M4 12h16M14 6l6 6-6 6"/>
    {%- when 'chevron' -%}
      <path d="M9 5l7 7-7 7"/>
    {%- when 'back' -%}
      <path d="M15 5l-7 7 7 7"/>
    {%- when 'down' -%}
      <path d="M5 9l7 7 7-7"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="M4 12.5l5 5L20 6.5"/>
    {%- when 'play' -%}
      <path d="M7 4.5v15l13-7.5z" fill="currentColor"/>
    {%- when 'cube' -%}
      <path d="M12 2.8l8 4.6v9.2l-8 4.6-8-4.6V7.4z"/><path d="M4 7.4l8 4.6 8-4.6M12 12v9.2"/>
    {%- when 'ruler' -%}
      <path d="M2.5 15.5L15.5 2.5l6 6-13 13z"/><path d="M7 11l2 2M10 8l2 2M13 5l2 2M5 14l1.5 1.5"/>
    {%- when 'pin' -%}
      <path d="M12 21s7-6.2 7-11.5a7 7 0 0 0-14 0C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
    {%- when 'filter' -%}
      <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>
    {%- when 'facebook' -%}
      <path d="M14 21v-7.5h2.6l.4-3H14V8.7c0-.9.3-1.5 1.5-1.5H17V4.5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.7 1.4-3.7 3.9v2.2H8.5v3H11V21"/>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.2 4.4 5 4.6"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9"/><path d="M10.6 20.5l1.9-8.2M9.2 13.2c-.8-2.8 1-5.4 3.7-5.4 2.3 0 3.6 1.6 3.6 3.6 0 2.3-1.2 4.3-3 4.3-1 0-1.6-.8-1.4-1.7"/>
    {%- when 'x' -%}
      <path d="M4 4l16 16M20 4L4 20"/>
    {%- when 'snapchat' -%}
      <path d="M12 3.5c3 0 5 2.2 5 5v2.3l1.8.6-1.3 1.6c.6 1.8 1.8 2.8 3 3.2-.8.8-2 .9-2.7 1.1l-.4 1.4c-1.4-.3-2.4.2-3.4.8-.6.3-1.2.5-2 .5s-1.4-.2-2-.5c-1-.6-2-1.1-3.4-.8l-.4-1.4c-.7-.2-1.9-.3-2.7-1.1 1.2-.4 2.4-1.4 3-3.2L5.2 11.4 7 10.8V8.5c0-2.8 2-5 5-5z"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>
    {%- when 'return' -%}
      <path d="M4 9h11a5 5 0 0 1 0 10H9"/><path d="M8 5L4 9l4 4"/>
    {%- when 'spark' -%}
      <path d="M12 3v5M12 16v5M3 12h5M16 12h5M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3"/>
    {%- when 'tag' -%}
      <path d="M3.5 12.5l8.5 8.5 9-9V3.5H12.5z"/><circle cx="16.5" cy="7.5" r="1.3"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8.5" width="17" height="4"/><path d="M5 12.5v8h14v-8M12 8.5v12"/><path d="M12 8.5c-1.5-3.5-6-3.5-5-1 .6 1.3 5 1 5 1zM12 8.5c1.5-3.5 6-3.5 5-1-.6 1.3-5 1-5 1z"/>
    {%- when 'link' -%}
      <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.2 1.2"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.2-1.2"/>
  {%- endcase -%}
</svg>
