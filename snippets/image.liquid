{%- comment -%}
  Responsive image that honours the merchant's focal point.
  Params: image (required), sizes, class, alt (leave out for the image's own alt text, pass '' for a decorative image),
          fallback_alt (used when the image has no alt text of its own, for example the product or article title), eager (boolean), max (max width, default 2400)
{%- endcomment -%}
{%- liquid
  assign max = max | default: 2400
  assign focal = image.presentation.focal_point | default: '50% 50%'
  assign position = 'object-position: ' | append: focal
  # alt left out: the image's own descriptive alt. alt: '' marks a decorative image and stays empty.
  if alt == nil
    assign alt_text = image.alt | default: fallback_alt | default: '' | strip_html | strip
  else
    assign alt_text = alt
  endif
  assign sizes = sizes | default: '100vw'
  assign widths = '240, 360, 480, 640, 800, 960, 1200, 1500, 1800, 2400'
  if eager
    assign loading = 'eager'
    assign priority = 'high'
  else
    assign loading = 'lazy'
    assign priority = 'auto'
  endif
-%}
{{ image | image_url: width: max | image_tag: widths: widths, sizes: sizes, loading: loading, fetchpriority: priority, class: class, alt: alt_text, style: position }}
